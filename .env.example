# ════════════════════════════════════════════════════════════════
#  SFOMO — Environment Variables
#  Copy to .env (local) or paste into Railway service variables.
#
#  Generate secure keys:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
#  RAILWAY DEPLOYMENT GUIDE
#  ─────────────────────────────────────────────────────────────
#  1. Create a new Railway project.
#  2. Add two services from the repo (set each service's root dir):
#       • Backend  → root: backend/   (Python)
#       • Frontend → root: frontend/  (Node)
#  3. Add plugins to the project:
#       • PostgreSQL  — DATABASE_URL is injected automatically
#       • Redis       — REDIS_URL is injected automatically
#  4. Set variables below in each service's Railway dashboard.
#
#  Backend service variables:  APP_ENV, SECRET_KEY, API_KEY,
#    OPENAI_API_KEY, EXCHANGE_*, QDRANT_*, CORS_ORIGINS
#  Frontend service variables: NEXT_PUBLIC_API_URL,
#    NEXT_PUBLIC_WS_URL, NEXT_PUBLIC_API_KEY
#
#  Note: DATABASE_URL and REDIS_URL are auto-injected by Railway
#  plugins. If you set them manually, the postgres:// prefix is
#  accepted — it is auto-converted to postgresql+asyncpg://.
# ──────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────
# Railway auto-sets RAILWAY_ENVIRONMENT=production; APP_ENV is
# used as fallback for local / non-Railway environments.
APP_ENV=development
LOG_LEVEL=INFO
# REQUIRED — min 32 chars, no default
SECRET_KEY=
# REQUIRED — Bearer token for all /api/* and WebSocket endpoints
API_KEY=
# REQUIRED for kill-switch reset — separate high-privilege key, generate independently
ADMIN_KEY=

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Local:   http://localhost:3000
# Railway: https://your-frontend.up.railway.app
CORS_ORIGINS=http://localhost:3000

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Exchange (CCXT) ──────────────────────────────────────────
# Supports: binance, bybit, okx, kraken
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true

# ─── Database ─────────────────────────────────────────────────
# Railway PostgreSQL plugin injects DATABASE_URL automatically.
# For local docker-compose:
POSTGRES_USER=sfomo
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://sfomo:CHANGE_ME@localhost:5432/sfomo

# ─── Redis ────────────────────────────────────────────────────
# Railway Redis plugin injects REDIS_URL automatically.
# For local docker-compose:
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ─── Qdrant ───────────────────────────────────────────────────
# Use Qdrant Cloud (https://cloud.qdrant.io) for Railway deploys.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Market Data ──────────────────────────────────────────────
COINGLASS_API_KEY=
GLASSNODE_API_KEY=

# ─── Trading Parameters ───────────────────────────────────────
INITIAL_CAPITAL=10000
BASE_CURRENCY=USDT
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE=0.005
MAX_PORTFOLIO_DRAWDOWN=0.15
LEVERAGE=1

# ─── Strategy Weights (must sum to 1.0) ───────────────────────
WEIGHT_TREND_FOLLOWING=0.30
WEIGHT_MOMENTUM_BREAKOUT=0.25
WEIGHT_MEAN_REVERSION=0.20
WEIGHT_VOLATILITY_ARB=0.15
WEIGHT_PORTFOLIO_ROTATION=0.10

# ─── Trading Pairs & Timeframe ────────────────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,AVAX/USDT
TIMEFRAME=1h

# ─── Frontend (Next.js — set in Railway frontend service) ─────
# NEXT_PUBLIC_API_URL:  public URL of the backend Railway service
# NEXT_PUBLIC_WS_URL:   same host, wss:// scheme
# NEXT_PUBLIC_API_KEY:  must match API_KEY above
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_KEY=
