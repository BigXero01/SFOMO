# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Exchange (CCXT) ──────────────────────────────────────────
# Supports: binance, bybit, okx, kraken, coinbase
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sfomo:sfomo@localhost:5432/sfomo
TIMESCALE_URL=postgresql+asyncpg://sfomo:sfomo@localhost:5432/sfomo

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Market Data ──────────────────────────────────────────────
COINGLASS_API_KEY=
GLASSNODE_API_KEY=

# ─── Trading Parameters ───────────────────────────────────────
INITIAL_CAPITAL=10000
BASE_CURRENCY=USDT
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE=0.005          # 0.5% per trade
MAX_PORTFOLIO_DRAWDOWN=0.15   # 15% max drawdown kill switch
LEVERAGE=1                    # 1x = spot, increase for futures

# ─── Strategy Weights (must sum to 1.0) ───────────────────────
WEIGHT_TREND_FOLLOWING=0.30
WEIGHT_MOMENTUM_BREAKOUT=0.25
WEIGHT_MEAN_REVERSION=0.20
WEIGHT_VOLATILITY_ARB=0.15
WEIGHT_PORTFOLIO_ROTATION=0.10

# ─── Targets ──────────────────────────────────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,AVAX/USDT
TIMEFRAME=1h
