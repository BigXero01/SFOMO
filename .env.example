# ─── Generate secrets (run once) ──────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"

# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# REQUIRED — min 32 chars, no default
SECRET_KEY=
# REQUIRED — Bearer token for all /api/* endpoints
API_KEY=

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Exchange (CCXT) ──────────────────────────────────────────
# Supports: binance, bybit, okx, kraken
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=sfomo
# REQUIRED — strong password, no default allowed
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://sfomo:CHANGE_ME@localhost:5432/sfomo

# ─── Redis ────────────────────────────────────────────────────
# REQUIRED — password for Redis auth
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ─── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# REQUIRED — API key for Qdrant auth
QDRANT_API_KEY=

# ─── Market Data ──────────────────────────────────────────────
COINGLASS_API_KEY=
GLASSNODE_API_KEY=

# ─── Trading Parameters ───────────────────────────────────────
INITIAL_CAPITAL=10000
BASE_CURRENCY=USDT
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE=0.005
MAX_PORTFOLIO_DRAWDOWN=0.15
LEVERAGE=1

# ─── Strategy Weights (must sum to 1.0) ───────────────────────
WEIGHT_TREND_FOLLOWING=0.30
WEIGHT_MOMENTUM_BREAKOUT=0.25
WEIGHT_MEAN_REVERSION=0.20
WEIGHT_VOLATILITY_ARB=0.15
WEIGHT_PORTFOLIO_ROTATION=0.10

# ─── Targets ──────────────────────────────────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,AVAX/USDT
TIMEFRAME=1h

# ─── Frontend (Next.js public vars) ───────────────────────────
# Must match API_KEY above — exposed to browser for WS terminal auth
NEXT_PUBLIC_API_KEY=
